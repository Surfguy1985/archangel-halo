# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Compiled output ───────────────────────────────────────────────────────────
dist
tmp
out-tsc
*.tsbuildinfo

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules

# ── Environment / secrets ─────────────────────────────────────────────────────
# NEVER commit real env files. Copy .env.example → .env and fill in values.
.env
.env.*
!.env.example
!.env.*.example

# ── Private keys & certificates ───────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
.netrc

# ── Replit runtime / session files ───────────────────────────────────────────
.cache/
.local/
.expo/
.expo-shared/
.replit.deploy

# ── Generated codebase exports ────────────────────────────────────────────────
# These are Replit-session artifacts — not source code.
exports/
artifacts/halo/public/halo-backend-codebase.md
artifacts/halo/public/halo-backend-codebase.zip

# ── Uploaded / attached assets ────────────────────────────────────────────────
# Files uploaded during Replit sessions (PDFs, images, etc.) — not source code.
attached_assets/

# ── IDEs and editors ─────────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ── VSCode (keep shared settings, ignore personal) ───────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Cursor ────────────────────────────────────────────────────────────────────
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# ── Misc ─────────────────────────────────────────────────────────────────────
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# ── System files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
halo-write-token.txt
