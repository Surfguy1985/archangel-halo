# ─────────────────────────────────────────────────────────────────────────────
# HALO — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# On Replit these values live in Secrets (not in .env files).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Session / Auth ────────────────────────────────────────────────────────────
SESSION_SECRET=replace_with_a_long_random_string_min_32_chars

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me

# ── Banking (Plaid — Production keys) ────────────────────────────────────────
PLAID_CLIENT_ID=replace_me
PLAID_SECRET=replace_me

# ── Object Storage ────────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replace_me
PRIVATE_OBJECT_DIR=replace_me
PUBLIC_OBJECT_SEARCH_PATHS=replace_me

# ── HALO internal read token ──────────────────────────────────────────────────
HALO_READ_TOKEN=replace_me

# ── Base44 operational source of record (read-only ingest) ───────────────────
# Defaults to the production Make-Ready Flow haloRead function if unset.
BASE44_READ_URL=https://wakeful-ready-track-flow.base44.app/functions/haloRead
BASE44_READ_TIMEOUT_MS=15000

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3001

# ── AI integrations (Replit-managed proxy in Replit; direct keys in Cursor) ──
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_ANTHROPIC_API_KEY=replace_me
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── App URLs (set to your local or deployed URL) ──────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
HALO_API_BASE_URL=http://localhost:3000/api
HALO_DASHBOARD_URL=http://localhost:3000/desktop/
ALLOWED_ORIGINS=http://localhost:3000
# Production: comma-separated frontend origins (Replit + any office hosts).
# If unset in production, cross-origin requests are denied.

# ── Enforcer V3 (required in production — fail closed if missing) ─────────────
# NODE_ENV=production requires Enforcer unless HALO_ENFORCER_REQUIRED=false
# (explicit staged-rollout opt-out). Missing tenant/issuer/JWKS then fail closed.
#   HALO_ENFORCER_TENANT_ID, HALO_ENFORCER_ISSUER, HALO_ENFORCER_JWKS_URL
# Do not use a placeholder tenant. If accounts/me is set, it must be reachable.
# HALO_ENFORCER_REQUIRED=true
# HALO_ENFORCER_TENANT_ID=
# HALO_ENFORCER_ISSUER=
# HALO_ENFORCER_JWKS_URL=
# HALO_ENFORCER_AUDIENCE=
# HALO_ENFORCER_ACCOUNTS_URL=

# ── Falkon Ops (S2S). Production must set origin + client id. Never hardcode a Replit host.
# FALKON_GATEWAY_ORIGIN=https://gateway.example/api
# FALKON_API_BASE_URL=https://gateway.example/api
# FALKON_CLIENT_ID=
# FALKON_PARTNER_ID=
# FALKON_TENANT=

# Pulse (property-manager seat). Default lock is Thornbury at Chase Oaks.
# HALO_PULSE_ALLOWLIST=Thornbury at Chase Oaks
# HALO_PULSE_ALLOWLIST=*
# HALO_PULSE_PM_PASSWORD=choose_a_strong_password

# ── Crew portal (legacy OS). Production hides /portal unless explicitly enabled.
# One-tap /checkin/:token is the production crew surface.
# HALO_CREW_PORTAL_ENABLED=false

# ── Twilio (optional). Env wins over Replit connector. Auth token required for inbound HMAC.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_API_KEY=
# TWILIO_API_KEY_SECRET=

# ── Vapi outbound EOD (optional). All three required or field.voice_eod fails closed.
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=

