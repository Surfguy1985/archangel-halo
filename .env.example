# ─────────────────────────────────────────────────────────────────────────────
# HALO — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# On Replit these values live in Secrets (not in .env files).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Session / Auth ────────────────────────────────────────────────────────────
SESSION_SECRET=replace_with_a_long_random_string_min_32_chars

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me

# ── Banking (Plaid — Production keys) ────────────────────────────────────────
PLAID_CLIENT_ID=replace_me
PLAID_SECRET=replace_me

# ── Object Storage ────────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replace_me
PRIVATE_OBJECT_DIR=replace_me
PUBLIC_OBJECT_SEARCH_PATHS=replace_me

# ── HALO internal read token ──────────────────────────────────────────────────
HALO_READ_TOKEN=replace_me

# ── AI integrations (Replit-managed proxy in Replit; direct keys in Cursor) ──
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_ANTHROPIC_API_KEY=replace_me
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── App URLs (set to your local or deployed URL) ──────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
HALO_API_BASE_URL=http://localhost:3000/api
HALO_DASHBOARD_URL=http://localhost:3000/desktop/
ALLOWED_ORIGINS=http://localhost:3000
