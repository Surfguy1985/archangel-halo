{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "HALO Design System tokens (DTCG). Single source of truth. Edit here only — never hand-edit src/index.css or src/generated/tokens.tsx. Dark-navy + lime (#B4FF44) brand palette extracted from artifacts/halo and artifacts/halo-desktop.",
  "color": {
    "$type": "color",
    "light": {
      "background":           { "$value": "#F4F7F9", "$description": "Page canvas — --paper" },
      "foreground":           { "$value": "#07101E", "$description": "Default text — --ink" },
      "card":                 { "$value": "#FFFFFF", "$description": "Card surface" },
      "cardForeground":       { "$value": "#07101E" },
      "popover":              { "$value": "#FFFFFF" },
      "popoverForeground":    { "$value": "#07101E" },
      "primary":              { "$value": "#B4FF44", "$description": "Brand lime — --gold-light. Used for primary buttons, active indicators, and brand emphasis." },
      "primaryForeground":    { "$value": "#000000", "$description": "Must be black on lime for WCAG AA" },
      "secondary":            { "$value": "#13223A", "$description": "Dark navy — --ink2. Secondary surfaces and action buttons." },
      "secondaryForeground":  { "$value": "#FFFFFF" },
      "muted":                { "$value": "#EBF0F6", "$description": "Muted surface — light blue-grey" },
      "mutedForeground":      { "$value": "#435A7D", "$description": "Subdued text — --muted" },
      "accent":               { "$value": "#F0FAE0", "$description": "Lime tint accent surface — derived from --gold-tint" },
      "accentForeground":     { "$value": "#557F0D", "$description": "Dark olive — --gold-dark" },
      "destructive":          { "$value": "#E11D48", "$description": "Danger red — --red" },
      "destructiveForeground":{ "$value": "#FFFFFF" },
      "border":               { "$value": "#DDE7F2", "$description": "Default border — approximation of --hairline (rgba(19,34,58,0.12))" },
      "input":                { "$value": "#DDE7F2" },
      "ring":                 { "$value": "#6D9B12", "$description": "Focus ring — --gold (olive green)" },
      "chart1":               { "$value": "#EA580C", "$description": "--orange" },
      "chart2":               { "$value": "#CA8A04", "$description": "--yellow" },
      "chart3":               { "$value": "#15803D", "$description": "--green" },
      "chart4":               { "$value": "#2563EB", "$description": "--blue" },
      "chart5":               { "$value": "#7C3AED", "$description": "--purple" },
      "sidebar":              { "$value": "#07101E", "$description": "Sidebar is always dark navy — --app-backdrop" },
      "sidebarForeground":    { "$value": "#F4F7F9" },
      "sidebarBorder":        { "$value": "#1B2D45" },
      "sidebarPrimary":       { "$value": "#B4FF44" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent":        { "$value": "#13223A" },
      "sidebarAccentForeground": { "$value": "#B4FF44" },
      "sidebarRing":          { "$value": "#B4FF44" }
    },
    "dark": {
      "background":           { "$value": "#041029", "$description": "Deepest navy — desktop primary background" },
      "foreground":           { "$value": "#F4F7F9" },
      "card":                 { "$value": "#07101E", "$description": "Slightly lighter than background" },
      "cardForeground":       { "$value": "#F4F7F9" },
      "popover":              { "$value": "#0D1E33" },
      "popoverForeground":    { "$value": "#F4F7F9" },
      "primary":              { "$value": "#B4FF44", "$description": "Lime is brand-constant across both themes" },
      "primaryForeground":    { "$value": "#000000" },
      "secondary":            { "$value": "#0A1930", "$description": "Navy panel surface" },
      "secondaryForeground":  { "$value": "#F4F7F9" },
      "muted":                { "$value": "#13223A" },
      "mutedForeground":      { "$value": "#8CA0B9", "$description": "Faint blue-grey — --faint" },
      "accent":               { "$value": "#172C0A", "$description": "Dark lime tint — rgba(180,255,68,0.15) on #041029" },
      "accentForeground":     { "$value": "#B4FF44" },
      "destructive":          { "$value": "#E11D48" },
      "destructiveForeground":{ "$value": "#FFFFFF" },
      "border":               { "$value": "#1A2E45", "$description": "Dark border — derived from --hairline2" },
      "input":                { "$value": "#1A2E45" },
      "ring":                 { "$value": "#B4FF44", "$description": "Lime focus ring on dark" },
      "chart1":               { "$value": "#F97316", "$description": "Brighter orange for dark contrast" },
      "chart2":               { "$value": "#EAB308", "$description": "Brighter yellow" },
      "chart3":               { "$value": "#22C55E", "$description": "Brighter green" },
      "chart4":               { "$value": "#3B82F6", "$description": "Brighter blue" },
      "chart5":               { "$value": "#8B5CF6", "$description": "Brighter purple" },
      "sidebar":              { "$value": "#041029" },
      "sidebarForeground":    { "$value": "#F4F7F9" },
      "sidebarBorder":        { "$value": "#0A1930" },
      "sidebarPrimary":       { "$value": "#B4FF44" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent":        { "$value": "#13223A" },
      "sidebarAccentForeground": { "$value": "#B4FF44" },
      "sidebarRing":          { "$value": "#B4FF44" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Plus Jakarta Sans", "system-ui", "sans-serif"], "$description": "UI body face. Loaded from Google Fonts." },
      "serif": { "$value": ["Outfit", "sans-serif"], "$description": "Display / heading face. Loaded from Google Fonts." },
      "mono":  { "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.875rem", "$description": "14px base radius — matches HALO --radius: 14px. sm/md/lg/xl derive from this." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Tailwind default base step." }
  }
}
