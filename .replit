modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["bash", "-c", "pnpm store prune && rm -rf .local/share/pnpm .cache/pnpm .cache/typescript .local/state"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "codegen-check"

[[workflows.workflow]]
name = "codegen-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm codegen:check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
HALO_API_BASE_URL = "https://bff8695c-1bc6-462a-82ec-dbe35b22681d-00-wh8czlva3w1n.spock.replit.dev/api"
HALO_DASHBOARD_URL = "https://bff8695c-1bc6-462a-82ec-dbe35b22681d-00-wh8czlva3w1n.spock.replit.dev/desktop/"
PUBLIC_APP_URL = "https://bff8695c-1bc6-462a-82ec-dbe35b22681d-00-wh8czlva3w1n.spock.replit.dev/"
ALLOWED_ORIGINS = "https://bff8695c-1bc6-462a-82ec-dbe35b22681d-00-wh8czlva3w1n.spock.replit.dev"
HALO_SMS_FROM_NUMBER = "+19724719091"
HALO_PULSE_ALLOWLIST = "*"

[userenv.development]
